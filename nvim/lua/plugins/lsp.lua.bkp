-- ~/.config/nvim/lua/plugins/lsp.lua

-- Optional cmp capabilities (won't crash if cmp-nvim-lsp isn't installed)
local capabilities = vim.lsp.protocol.make_client_capabilities()
do
  local ok, cmp = pcall(require, "cmp_nvim_lsp")
  if ok and cmp and type(cmp.default_capabilities) == "function" then
    capabilities = vim.tbl_deep_extend("force", capabilities, cmp.default_capabilities())
  end
end

-- Global defaults for every server
vim.lsp.config("*", {
  capabilities = capabilities,
  -- on_attach = function(client, bufnr) ... end, -- add keymaps here if you want
})

-- Per-server settings (still all in this one file)
vim.lsp.config("lua_ls", {
  settings = {
    Lua = {
      diagnostics = { globals = { "vim" } },
    },
  },
})

-- Globally configure all LSP floating preview popups (hover, signature, etc.)
do
  local orig = vim.lsp.util.open_floating_preview
  function vim.lsp.util.open_floating_preview(contents, syntax, opts, ...)
    opts = opts or {}
    opts.border = opts.border or "rounded"
    return orig(contents, syntax, opts, ...)
  end
end

-- Enable the servers you want
vim.lsp.enable({
  "bashls",
  "cssls",
  "html",
  "lua_ls",
  "jsonls",
  "lemminx",
  "marksman",
  "quick_lint_js",
  "yamlls",
  "pyright",
  "clangd",
})

